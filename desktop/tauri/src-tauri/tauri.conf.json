{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HolosTTS",
  "version": "0.7.0",
  "identifier": "ua.morkon.holostts",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HolosTTS",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "resources": {
      "resources/lib/": "lib/"
    },
    "externalBin": ["binaries/holos-server"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "category": "Utility",
    "shortDescription": "Ukrainian text-to-speech",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
